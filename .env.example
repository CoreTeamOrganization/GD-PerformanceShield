# Root directory for analysis workspaces (default: ./analysis)
GDPS_WORKSPACE_ROOT=./analysis
# Explicit adb binary path (default: resolved from PATH / ANDROID_HOME)
GDPS_ADB_PATH=
# Optional aapt2 binary for APK cross-check (default: auto-detected in ANDROID_HOME/build-tools)
GDPS_AAPT2_PATH=
# Operator UI / API port
GDPS_PORT=7845
# GitHub token used for private repo clone (https://x-access-token:<TOKEN>@github.com/...)
GDPS_GITHUB_TOKEN=
# Log level: trace|debug|info|warn|error
GDPS_LOG_LEVEL=info
